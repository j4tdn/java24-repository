+package view;
+
+import bean.Apple;
+import model.DataModel;
+
+import java.util.*;
+import java.util.function.Function;
+
+public class Ex02MethodReference {
+    public static void main(String[] args) {
+        var inventory = new ArrayList<>(DataModel.getApples());
+        inventory.forEach(System.out::println);
+        System.out.println(mapping(inventory, Apple::getColor));
+        inventory.sort(Comparator.comparing(Apple::getColor, Comparator.reverseOrder()).thenComparing(Apple::getId, Comparator.reverseOrder()));
+    }
+
+    private static <T,R> Set<R> mapping(List<T> e, Function<T,R> func){
+        Set<R> set = new HashSet<>();
+
+        for (T t : e) {
+            set.add(func.apply(t));
+        }
+
+        return set;
+    }
+
+}
