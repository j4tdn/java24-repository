+package view.stream;
+
+import java.util.List;
+import java.util.Optional;
+
+public class Ex07StreamMatching {
+    public static void main(String[] args) {
+        List<Integer> elements = List.of(1, 2, 1, 4, 5, 8, 7, 10, 4, 12);
+
+        var res1 = elements.stream().anyMatch(e -> e % 10 == 0);
+        Optional<Integer> res2 = elements.stream().filter(e -> e % 4 == 0).findFirst();
+        res2.ifPresent(System.out::println);
+    }
+}
