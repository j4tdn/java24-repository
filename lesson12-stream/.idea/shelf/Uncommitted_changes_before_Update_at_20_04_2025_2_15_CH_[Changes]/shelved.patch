@@ -0,0 +1,27 @@
+package view.stream;
+
+import bean.Apple;
+import model.DataModel;
+
+import java.util.*;
+import java.util.function.Function;
+import java.util.stream.Collectors;
+
+public class Ex05StreamDistinctBy {
+    public static void main(String[] args) {
+        List<Integer> elements = List.of(0,0,1,21,3,5,5,21,34, 34);
+
+        List<Apple> inventory = DataModel.getApples();
+
+        List<Apple> distinctApplesByCountry = distinctBy(inventory, Apple::getCountry);
+        List<Apple> distinctApplesByWeight = distinctBy(inventory, Apple::getWeight);
+
+        System.out.println(distinctApplesByCountry);
+        System.out.println(distinctApplesByWeight);
+    }
+
+    private static <Element, T> List<Element> distinctBy(List<Element> elements, Function<Element, T> func) {
+        Set<T> seen = new HashSet<T>();
+        return elements.stream().filter(e -> seen.add(func.apply(e))).collect(Collectors.toList());
+    }
+}
